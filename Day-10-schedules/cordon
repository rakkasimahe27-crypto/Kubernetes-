kubectl cordon <node name>  
kubectl cordon ip-10-0-4-153.ec2.internal  

  # no pod schedule on this node until uncordon
  # we prefer this process while cluster upgrade time ---> not allow any further deployment until complete cluster upgrade 
## after cordon run deploymnet and observe it schedule allow to schedule pod only availbe node not on cordoned node 
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-deployment
  labels:
    app: nginx
spec:
  replicas: 3
  selector:
    matchLabels:
      app: nginx
  template:
    metadata:
      labels:
        app: nginx
    spec:
      containers:
      - name: nginx
        image: nginx:1.14.2
        ports:
        - containerPort: 80

